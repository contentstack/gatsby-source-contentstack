# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-ESLINT-15102420:
    - '*':
        reason: >-
          Nested inside gatsby@5.16.1's own bundled eslint (dev-tooling only,
          not our dependency). Fix requires eslint 7->9 major bump we don't
          control; would risk breaking gatsby's internal webpack eslint-loader.
          No plugin-side fix possible.
        expires: 2026-10-27T00:00:00.000Z
        created: 2026-07-29T11:11:17.418Z
  SNYK-JS-JSYAML-17342520:
    - '*':
        reason: >-
          Nested inside gatsby@5.16.1 > eslint@7.32.0 (dev-tooling only). Fix
          requires js-yaml 3->4 major bump, breaking API eslint@7 depends on.
          Not fixable without patching gatsby itself.
        expires: 2026-10-27T00:00:00.000Z
        created: 2026-07-29T11:11:26.190Z
  SNYK-JS-JSYAML-18313070:
    - '*':
        reason: >-
          Same as SNYK-JS-JSYAML-17342520: nested inside gatsby@5.16.1 >
          eslint@7.32.0, no safe fix without breaking gatsby's bundled eslint.
        expires: 2026-10-27T00:00:00.000Z
        created: 2026-07-29T11:11:34.401Z
  SNYK-JS-REACTDEVUTILS-17890708:
    - '*':
        reason: >-
          Snyk reports no upgrade or patch available. Bundled inside
          gatsby@5.16.1's dev-server tooling, not exposed by this plugin.
          Tracked for re-check at expiry.
        expires: 2026-10-27T00:00:00.000Z
        created: 2026-07-29T11:11:45.412Z
